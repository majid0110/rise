# Copy to .env for local development. Never commit .env.
# Both values come from Supabase > Project Settings > API.
# The anon (public) key is safe in a browser app ONLY because Row Level Security protects the data.
# NEVER put the service_role key anywhere in this project.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
